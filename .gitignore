htmlcov/
.pytest_cache/

# --- Bundled resources: keep the small finals, not the masters ---
# app_icon.png / app_icon.ico are tracked (the build needs them); the 2048px
# source art and any working files do not belong in history.
resources/icons/original/

# --- Code-transfer snapshots (generated by all_code_writer.py) ---
# These are dumps of the very code this repository already versions.
# They stay on disk for the manual transfer workflow, but committing them
# would add a few hundred KB of duplicated source to the history every time.
NVH_Tool_v01_*.txt
config_*.txt
recept_bryndzove_halusky.txt
api_key.env
.env
.aider*

.cursor/rules/local-*.mdc

# graphify
graphify-out/
.graphifyignore

# --- Frozen build (packaging/build_exe.ps1) ---
.build-venv/
build/
dist/
